# Copy this file to ".env" (same folder) if you prefer files over the Settings page. All lines are optional.
WH_API_KEY=
# Paid rotating proxy (optional, used instead of Tor):  http://user:pass@host:port
WH_PROXY=
# Web server: 127.0.0.1 = only this computer. Use 0.0.0.0 on a server AND set a password in Settings.
WH_HOST=127.0.0.1
WH_PORT=8000
WH_WEB_PASSWORD=
META_API_TOKEN=
