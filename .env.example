# Copy this file to .env before running Docker Compose.
# The Compose service requires a non-empty strong password, even when used locally.
WH_WEB_PASSWORD=

# Host binding defaults to this computer only. Set 0.0.0.0 only when protected by
# a trusted HTTPS reverse proxy and firewall rules.
WH_BIND=127.0.0.1
WH_PUBLIC_PORT=8000

# Optional: only WinningHunter Scan and Estimate modes use this key and may consume
# the associated account's API credits. Verify/Rebuild do not need it.
WH_API_KEY=
